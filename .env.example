# Host port for the browser preview and device API.
SLATE_PORT=8000

# Re-render interval in seconds.
SLATE_REFRESH_SECONDS=60

# Python strftime format for the current date provider.
SLATE_DATE_FORMAT=%A, %B %d

# Generate locally with: openssl rand -hex 32
SLATE_DEVICE_TOKEN=

# Set false only for a private local demo without a TLS proxy.
# Production should keep true and use a trusted TLS-terminating proxy.
SLATE_REQUIRE_HTTPS=false

# Leave empty to use fictional sample data. Set to a secret HTTPS iCal URL to
# use Google Calendar. Never commit the real URL.
SLATE_CALENDAR_ICAL_URL=
# Generic timezone used by the process and calendar display (IANA name).
TZ=UTC
SLATE_CALENDAR_MAX_EVENTS=6
SLATE_CALENDAR_DAYS_AHEAD=14
SLATE_CALENDAR_HEADLINE=Upcoming events

# Optional Home Assistant power sensor integration. Keep the long-lived token
# only in this ignored local file; never add a real token or private URL to Git.
SLATE_HOME_ASSISTANT_URL=
SLATE_HOME_ASSISTANT_TOKEN=
SLATE_HOME_ASSISTANT_POWER_CONSUMPTION_ENTITY=

# Open-Meteo hourly and daily precipitation forecasts (Rijswijk, The Netherlands).
SLATE_WEATHER_LATITUDE=52.04
SLATE_WEATHER_LONGITUDE=4.33
SLATE_WEATHER_TIMEZONE=Europe/Amsterdam
SLATE_WEATHER_FORECAST_HOURS=4
SLATE_WEATHER_FORECAST_DAYS=4

# Optional local JSON file containing named literal text values.
# Example: /config/literal-text.json (copy from server/literal-text.example.json).
SLATE_LITERAL_TEXT_FILE=
