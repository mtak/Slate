# Host port for the browser preview and device API.
SLATE_PORT=8000

# Re-render interval in seconds.
SLATE_REFRESH_SECONDS=60

# Generate locally with: openssl rand -hex 32
SLATE_DEVICE_TOKEN=

# Set false only for a private local demo without a TLS proxy.
# Production should keep true and use a trusted TLS-terminating proxy.
SLATE_REQUIRE_HTTPS=false

# Use "google_calendar" to read a shared calendar with a Google service account.
SLATE_PROVIDER=sample
# Copy the downloaded service-account JSON here; this directory is ignored by Git.
SLATE_GOOGLE_CREDENTIALS_DIR=./secrets
# Calendar ID from Google Calendar settings (or the shared calendar's ID).
SLATE_GOOGLE_CALENDAR_ID=
# IANA timezone used for display and the query window, for example Europe/Amsterdam.
SLATE_TIMEZONE=UTC
SLATE_CALENDAR_MAX_EVENTS=6
SLATE_CALENDAR_DAYS_AHEAD=14
