# Host port for the browser preview and device API.
SLATE_PORT=8000

# Re-render interval in seconds.
SLATE_REFRESH_SECONDS=60

# Generate locally with: openssl rand -hex 32
SLATE_DEVICE_TOKEN=

# Set false only for a private local demo without a TLS proxy.
# Production should keep true and use a trusted TLS-terminating proxy.
SLATE_REQUIRE_HTTPS=false

# Leave empty to use fictional sample data. Set to a secret HTTPS iCal URL to
# use Google Calendar. Never commit the real URL.
SLATE_CALENDAR_ICAL_URL=
# Generic timezone used by the process and calendar display (IANA name).
TZ=UTC
SLATE_CALENDAR_MAX_EVENTS=6
SLATE_CALENDAR_DAYS_AHEAD=14
